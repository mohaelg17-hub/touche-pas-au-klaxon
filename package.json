{
    "name": "touche-pas-au-klaxon",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build:assets": "node scripts/copy-assets.js",
        "build:css": "sass --load-path=node_modules scss/main.scss public/assets/css/main.css",
        "build": "npm run build:assets && npm run build:css",
        "watch:css": "sass --watch --load-path=node_modules scss/main.scss public/assets/css/main.css"
    },
    "dependencies": {
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.2"
    },
    "devDependencies": {
        "sass": "^1.108.1"
    }
}